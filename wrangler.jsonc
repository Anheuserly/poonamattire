{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "poonamattire",
  "compatibility_date": "2026-06-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "build": {
    "command": "test -f .open-next/worker.js || npm run build"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "poonamattire"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "API_KEY_ADMIN": "PA_live_key_admin_portal_2026_poonam_hash",
    "DATABASE_URL": "postgresql://postgres:AnheVps2022@vps.amcmep.in:5432/poonamattire",
    "JWT_SECRET": "poonam_attire_super_secret_jwt_key_2026_festive",
    "NEXT_PUBLIC_API_KEY": "PA_live_key_web_client_2026_poonam_hash"
  }
}
